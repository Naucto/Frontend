{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "*.config.js",
    "tools/**/*",
    "e2e/**/*.ts",
    "packages/*/vitest.config.ts"
  ]
}
