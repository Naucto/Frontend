{
  "name": "naucto-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "patch-package",
    "start": "npm run start -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "docs:build": "node tools/docs-build.mjs",
    "icons:check": "node tools/build-icons.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.1",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "^22.1.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "@parcel/watcher": true,
    "msgpackr-extract": true,
    "msw": true
  }
}
