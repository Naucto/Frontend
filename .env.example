# Local development: nothing is required here. `npm install`, `npm start` and `./dev.sh` need no
# variable — `@naucto/api-client` is generated locally from packages/api-client/openapi.json.

# E2E and tooling, declared in tools/env.ts:
# E2E_BASE_URL=http://localhost:3001   # playwright.config.ts: test against a server already running instead of starting one
# CI=true                              # playwright.config.ts: forbids .only, 2 retries, github reporter; also skips two perf specs
# D2C=../Design2Code                   # npm run design:check: path to a Design2Code checkout
# NAUCTO_API=http://localhost:3000     # tools/seed-content.ts: the API it seeds through
# NAUCTO_SEED_PASSWORD=                # tools/seed-content.ts: password of the seeded accounts
# tools/migrate-games.ts reads DATABASE_URL and the S3_* variables of the Backend's .env, plus
# CONTENT_SIZE_MODULE and MIGRATE_GAMES_REPORT (where its JSON report goes).

# Production container only (not read by the dev tree): written to /config.json by
# nginx/40-runtime-config.sh, see docker-compose.yml.
APP_API_URL=
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_REDIRECT_URI=
APP_GITHUB_CLIENT_ID=
APP_GITHUB_REDIRECT_URI=
APP_MICROSOFT_CLIENT_ID=
APP_MICROSOFT_TENANT_ID=common
APP_MICROSOFT_REDIRECT_URI=
